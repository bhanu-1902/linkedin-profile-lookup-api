<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
          Spring Boot 4.1.1 was current as of August 2026 (verified via
          web search at build time, not from training data).
          Boot moved to a new major version, 4.0, in November 2025.
          If this has moved on when you build,
          `mvn versions:display-parent-updates` will tell you;
          bumping the patch version here is normally safe.
        -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.profilelookup</groupId>
    <artifactId>profile-lookup-api</artifactId>
    <version>0.1.0</version>
    <name>profile-lookup-api</name>
    <description>
        Hosted API returning structured profile JSON, built against a
        ProfileSource port with fixture and stub adapters only -- see
        openspec/changes/add-profile-lookup/design.md for why no live
        LinkedIn-scraping adapter is shipped.
    </description>

    <properties>
        <java.version>17</java.version>
        <!--
          springdoc-openapi's Spring-Boot-4-compatible line, verified via
          web search at build time (springdoc.org/v4). This line moves
          fast; check for a newer 3.x patch when you first build.
        -->
        <springdoc.version>3.0.3</springdoc.version>
        <!-- bucket4j-core has no Spring dependency, so it is Boot-version agnostic. -->
        <bucket4j.version>8.10.1</bucket4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          No spring-boot-starter-validation: URL validation lives in
          domain.LinkedInProfileUrls, a plain Java utility, not Bean
          Validation annotations. One fewer dependency, and one shared
          definition instead of a regex here and separate parsing logic
          in the adapter.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Spring Boot 4 split TestRestTemplate out of spring-boot-test
          into its own module, and it isn't pulled transitively by
          spring-boot-starter-test, confirmed by a real local build
          failure (spring-projects/spring-boot#48588 covers the same
          "resttestclient doesn't pull in restclient" gap). Both must be
          declared explicitly; the version comes from spring-boot-starter-parent's BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
