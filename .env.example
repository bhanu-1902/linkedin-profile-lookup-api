# Copy to .env for local runs, or set as real environment variables in
# your deployment platform. Never commit an actual .env file (it's in
# .gitignore).

PORT=8080

# fixture: serves the bundled sample-profiles.json fixture data
# stub: always returns "no live data source" (proves the honest-failure path)
PROFILE_SOURCE=fixture

# Comma-separated API keys. Generate real ones for a real deployment --
# this default is only for local demo use.
PROFILE_API_KEYS=demo-key-change-me

RATELIMIT_CAPACITY=20
RATELIMIT_REFILL_SECONDS=60
