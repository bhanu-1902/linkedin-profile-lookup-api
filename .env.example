# Copy to .env for local runs, or set as real environment variables in
# your deployment platform. Never commit an actual .env file (it's in
# .gitignore).

PORT=8080

# Default source is live LinkedIn HTTP. Optional overrides:
#   fixture — bundled sample-profiles.json (offline demos / tests)
#   stub    — always empty (honest-failure path)
PROFILE_SOURCE=linkedin

# Required for live lookups. Do not commit real values.
LINKEDIN_SESSION_COOKIE=
# Optional; set if your upstream expects it.
LINKEDIN_CSRF_TOKEN=
# Must return JSON the mapper understands. Include {handle} placeholder.
# A normal HTML profile page will map as 502 (unusable upstream body).
LINKEDIN_PROFILE_URL_TEMPLATE=
# LINKEDIN_USER_AGENT=Mozilla/5.0
# LINKEDIN_TIMEOUT_MS=8000

RATELIMIT_CAPACITY=20
RATELIMIT_REFILL_SECONDS=60
