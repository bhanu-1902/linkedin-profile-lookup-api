# Copy to .env for local runs, or set as real environment variables in
# your deployment platform. Never commit an actual .env file (it's in
# .gitignore).

PORT=8080

# fixture: serves the bundled sample-profiles.json fixture data
# stub: always returns "no live data source" (proves the honest-failure path)
# oidc: serves the profile of whoever most recently completed LinkedIn
#       sign-in via GET /v1/auth/linkedin/login -- see README, "LinkedIn
#       sign-in (OIDC self-lookup)". Requires the three LINKEDIN_* values
#       below; the app fails fast at startup if they're unset in this mode.
PROFILE_SOURCE=fixture

# Comma-separated API keys. Generate real ones for a real deployment --
# this default is only for local demo use.
PROFILE_API_KEYS=demo-key-change-me

RATELIMIT_CAPACITY=20
RATELIMIT_REFILL_SECONDS=60

# Only used when PROFILE_SOURCE=oidc. Register a LinkedIn Developer App
# (self-serve) with the "Sign In with LinkedIn using OpenID Connect"
# product enabled, and set its authorized redirect URL to match
# LINKEDIN_REDIRECT_URI exactly.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/v1/auth/linkedin/callback
